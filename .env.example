# ==================================================
# QuizTime — Environment Variables Template
# ==================================================
# Copy this file to .env for local development.
# In Vercel, configure these in Project Settings -> Environment Variables.
# NEVER commit real private credentials or .env files to Git.

# --- Client-Side Firebase Web Configuration (Safe for Browser, Protected by Security Rules) ---
# Optional if firebase-applet-config.json is present; required if overriding in Vercel.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# --- Optional External WebSocket Multiplayer Server ---
# Leave empty on Vercel to use built-in Firestore Real-Time Multiplayer Rooms.
# Set to wss://your-ws-host.example.com/ws if hosting server.ts separately on Render/Railway/Fly.
VITE_WS_URL=""

# --- Public App URL & Base Path (Optional) ---
# For GitHub Pages project repos (https://<user>.github.io/<repo>/), set VITE_BASE_PATH="/<repo>/"
# The GitHub Actions workflow (.github/workflows/deploy-pages.yml) sets this automatically.
VITE_BASE_PATH="/"
VITE_APP_URL="https://quiztime-game.vercel.app"

# --- Server-Only Runtime Variables (Do NOT prefix with VITE_) ---
APP_URL="https://quiztime-game.vercel.app"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
